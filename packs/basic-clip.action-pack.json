{
  "kind": "shunshou.action-pack",
  "schemaVersion": 2,
  "name": "摘录",
  "version": "1.1.0",
  "author": "养恐龙",
  "description": "复制链接、引用划选（带来源）、把摘录做成分享卡片；不含 AI，装上即用",
  "requires": {
    "capabilities": ["clip.copy", "share.card"],
    "connections": []
  },
  "provides": {
    "scene": {
      "id": "bazaar-clip",
      "name": "摘录",
      "base": true,
      "pinned": [],
      "tree": [
        {
          "kind": "action",
          "id": "bazaar-clip-page",
          "capability": "clip.copy",
          "label": "复制 Markdown 链接",
          "description": "复制为 [标题](链接)",
          "icon": "lucide:clipboard-copy",
          "params": { "template": "{{link}}" }
        },
        {
          "kind": "action",
          "id": "bazaar-clip-quote",
          "capability": "clip.copy",
          "label": "引用（带来源）",
          "description": "把划选复制成 Markdown 引用块",
          "icon": "lucide:quote",
          "params": { "template": "> {{selection.quote}}\n> 来源：{{link}}" }
        },
        {
          "kind": "action",
          "id": "bazaar-clip-card",
          "capability": "share.card",
          "label": "分享摘录",
          "description": "把划选文字生成分享图",
          "icon": "lucide:quote",
          "params": {
            "size": "auto",
            "blocks": [
              { "kind": "quote", "template": "{{selection}}" },
              { "kind": "meta", "template": "—— {{title}}" }
            ]
          },
          "then": [{ "capability": "deliver.copyImage", "label": "复制图片", "params": {} }]
        }
      ]
    }
  }
}
