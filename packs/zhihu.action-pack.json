{
  "kind": "shunshou.action-pack",
  "schemaVersion": 2,
  "name": "知乎",
  "version": "1.1.0",
  "author": "养恐龙",
  "description": "在知乎问题与专栏页面复制链接、复制网页剪藏，或生成全文分享卡片；装上即用",
  "requires": {
    "capabilities": ["clip.copy", "share.card"],
    "connections": []
  },
  "provides": {
    "scene": {
      "id": "bazaar-zhihu",
      "name": "知乎",
      "match": { "url": ["*://www.zhihu.com/question/*", "*://zhuanlan.zhihu.com/p/*"] },
      "priority": 10,
      "pinned": ["bazaar-zhihu-copy-link", "bazaar-zhihu-copy-clip"],
      "tree": [
        {
          "kind": "action",
          "id": "bazaar-zhihu-copy-link",
          "capability": "clip.copy",
          "label": "复制链接",
          "description": "复制为 [标题](链接)",
          "icon": "si:zhihu",
          "params": { "template": "{{link}}" }
        },
        {
          "kind": "action",
          "id": "bazaar-zhihu-copy-clip",
          "capability": "clip.copy",
          "label": "复制网页剪藏",
          "description": "复制正文与链接",
          "icon": "lucide:clipboard-copy",
          "params": { "template": "{{page.clip}}\n\n{{url}}" }
        },
        {
          "kind": "action",
          "id": "bazaar-zhihu-share",
          "capability": "share.card",
          "label": "分享全文卡片",
          "description": "把标题与正文渲染成分享图",
          "icon": "lucide:image",
          "params": {
            "size": "auto",
            "blocks": [
              { "kind": "title", "template": "{{title}}" },
              { "kind": "text", "template": "{{page.clip}}" },
              { "kind": "meta", "template": "{{url}}" }
            ]
          }
        }
      ]
    }
  }
}
