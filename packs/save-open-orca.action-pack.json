{
  "kind": "shunshou.action-pack",
  "schemaVersion": 2,
  "name": "存完打开（虎鲸）",
  "version": "1.0.0",
  "author": "养恐龙",
  "description": "存一篇虎鲸笔记，接着自动打开刚存的那一块——存完直接跳过去看 / 补写（需先配好虎鲸连接）",
  "requires": {
    "capabilities": ["orca.capture", "open.url"],
    "connections": [{ "kind": "orca", "label": "虎鲸笔记" }]
  },
  "provides": {
    "scene": {
      "id": "bazaar-save-open-orca",
      "name": "存完打开（虎鲸）",
      "base": true,
      "pinned": [],
      "tree": [
        {
          "kind": "action",
          "id": "save-open-orca",
          "capability": "orca.capture",
          "label": "存虎鲸并打开",
          "description": "存虎鲸书签，接着打开刚存的那一块",
          "icon": "lucide:notebook-pen",
          "params": {
            "connection": "",
            "template": "{{link}}",
            "tags": [
              {
                "name": "书签",
                "props": { "标题": "{{title}}", "链接": "{{url}}", "域名": "{{hostname}}" }
              }
            ],
            "target": "",
            "position": "lastChild"
          },
          "then": [
            {
              "capability": "open.url",
              "label": "打开刚存的笔记",
              "params": { "url": "{{step.save-open-orca.link}}", "encode": "raw" }
            }
          ]
        }
      ]
    }
  }
}
