{
  "kind": "shunshou.action-pack",
  "schemaVersion": 2,
  "name": "B站字幕（带时间戳）",
  "version": "1.0.0",
  "author": "养恐龙",
  "description": "把 B站视频字幕按「[mm:ss] 句子」复制出来，方便对着进度条回看定位。需顺手 v0.19+（自带 B站字幕提取）、并在浏览器登录 B站；视频得有 CC 或 AI 字幕，否则会提示没有字幕。",
  "requires": {
    "capabilities": ["clip.copy"],
    "connections": []
  },
  "provides": {
    "scene": {
      "id": "bazaar-bili-subtitle-timed",
      "name": "B站字幕（带时间戳）",
      "match": { "url": "*://www.bilibili.com/video/*" },
      "priority": 10,
      "pinned": ["bazaar-bili-subtitle-timed-copy"],
      "tree": [
        {
          "kind": "action",
          "id": "bazaar-bili-subtitle-timed-copy",
          "capability": "clip.copy",
          "label": "复制带时间戳字幕",
          "description": "复制视频标题、链接与带时间戳的字幕（[mm:ss] 一句，需先登录 B站）",
          "icon": "lucide:clipboard-copy",
          "params": {
            "template": "{{title}}\n{{url}}\n\n{{field.bilibili.video.subtitles.timed}}"
          }
        }
      ]
    }
  }
}
